# Copy to .env and fill in. Do not commit .env.
GITHUB_TOKEN=

# run_pipeline.py
DESIGNITE_JAVA_JAR=C:\Users\bochi\Progetti\Designite\DesigniteJava.jar
DESIGNITE_CS_EXE=C:\Users\bochi\Progetti\Designite\DesigniteConsole\DesigniteConsole.exe
# arguments after the exe (same as DesigniteJava); {src} and {out} are filled in by the script
DESIGNITE_CS_ARGS=analyze -i {src} -o {out}
ARCAN_IMAGE=ghcr.io/arcan-tech/arcan-2-cli-trial:latest
ARCAN_LANG_JAVA=JAVA
ARCAN_LANG_CSHARP=CSHARP

# optional JVM options for Arcan (default heap = 1/4 of Docker memory)
ARCAN_JAVA_OPTS=-Xmx10g
